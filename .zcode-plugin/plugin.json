{
  "name": "zcode-beautify",
  "version": "6.3.0",
  "description": "Beautify the ZCode desktop client: import a background wallpaper and adapt the UI colors with Material Design 3 (Monet) dynamic color. Experimental CDP injection is explicit opt-in (disabled by default).",
  "author": {
    "name": "Mc-GrowlR"
  },
  "license": "MIT",
  "repository": "https://github.com/Logocceai/zcode-beautify",
  "commands": "commands",
  "skills": "skills",
  "mcpServers": {
    "zcode-beautify": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/mcp/server.js"
      ],
      "env": {
        "ZCODE_BEAUTIFY_DATA_DIR": "${ZCODE_PLUGIN_DATA}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "bubble-studio",
        "title": { "en": "Bubble Studio", "zh-CN": "气泡工坊" },
        "server": "zcode-beautify",
        "resourceUri": "ui://zcode-beautify/bubble-studio.html",
        "availability": "session"
      }
    ]
  },
  "category": "themes"
}
